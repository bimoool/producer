# Скопируйте в .env (на сервере) или .env.local (локально). Реальные значения в git не коммитятся.

# PostgreSQL: локальный, на сервере (docker compose) или Supabase (Connection string → URI)
DATABASE_URL=postgres://goal:CHANGE_ME@localhost:5432/goaltracker

# Вход в веб-интерфейс (HTTP Basic Auth). Пароль — минимум 8 символов.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Telegram (этап бота)
TELEGRAM_BOT_TOKEN=
# Telegram user ID (число), не токен. Несколько — через запятую.
TELEGRAM_ALLOWED_USER_IDS=
