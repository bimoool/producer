# Скопируйте в .env (на сервере) или .env.local (локально). Реальные значения в git не коммитятся.

# PostgreSQL (в docker compose задаётся POSTGRES_PASSWORD, строка подключения собирается сама)
DATABASE_URL=postgres://goal:CHANGE_ME@localhost:5432/goaltracker
POSTGRES_PASSWORD=

# Вход на сайт и бот: токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram user ID (число), которым разрешён вход. Не токен.
TELEGRAM_ALLOWED_USER_IDS=65107390
# Необязательно: имя бота без @ (иначе берётся через getMe)
TELEGRAM_BOT_USERNAME=
# Адрес сайта (для виджета входа)
APP_URL=https://producer.bimoool.com

# Google Sheets (только чтение). Таблица открыта email сервисного аккаунта с правом «Читатель».
# На сервере ключ лежит файлом и монтируется в контейнер read-only (deploy/install.sh):
GOOGLE_SERVICE_ACCOUNT_FILE_HOST=/etc/goaltracker/google-service-account.json
# Локально можно указать путь к файлу или JSON (base64) в переменной:
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/key.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
